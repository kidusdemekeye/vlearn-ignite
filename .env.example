# Copy to .env.local for local `vercel dev`, or set in Vercel project settings.
# Never commit a real key.
ANTHROPIC_API_KEY=
# Optional overrides
VLEARN_MODEL=claude-sonnet-5-5
VLEARN_QUICK_MODEL=claude-haiku-5-5

# Payments (Stripe). Create two recurring Prices in Stripe (Student $12/mo, Instructor $29/mo).
STRIPE_SECRET_KEY=
STRIPE_PRICE_STUDENT=
STRIPE_PRICE_INSTRUCTOR=
# Long random string used to sign plan passes (at least 16 characters).
# Use a DIFFERENT value for Production and for Preview/Development, so test-mode passes can't work in production.
VLEARN_PASS_SECRET=
# Public URL of this deployment, used for Stripe's return links.
APP_URL=https://your-app.vercel.app
# Required for payments: shared AI usage counter across serverless instances (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: Stripe's no-code customer portal login link (Stripe emails the customer a sign-in link).
# Shown as "Restore or manage a purchase" for people on a new device. Starts with https://billing.stripe.com/
STRIPE_PORTAL_LOGIN_URL=
