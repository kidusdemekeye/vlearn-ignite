# Copy to .env.local for local `vercel dev`, or set in Vercel project settings.
# Never commit a real key.
ANTHROPIC_API_KEY=
# Optional overrides
VLEARN_MODEL=claude-sonnet-5-5
VLEARN_QUICK_MODEL=claude-haiku-5-5

# Payments (Stripe). Create two recurring Prices in Stripe (Student $12/mo, Instructor $29/mo).
STRIPE_SECRET_KEY=
STRIPE_PRICE_STUDENT=
STRIPE_PRICE_INSTRUCTOR=
# Long random string used to sign plan passes (at least 16 characters).
VLEARN_PASS_SECRET=
# Public URL of this deployment, used for Stripe's return links.
APP_URL=https://your-app.vercel.app
# Optional: shared AI usage counter across serverless instances (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
